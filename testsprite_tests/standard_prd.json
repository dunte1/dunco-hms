  "product_overview": "DuncoHMS is a comprehensive, modular hospital management system designed to streamline hospital operations, patient management, staff coordination, and financial processes. It supports multiple user roles and offers modern web technologies for healthcare facilities, enabling efficient workflows and data management.",
  "core_goals": [
    "Provide end-to-end management for hospital operations including patient lifecycle, staff, billing, and resources.",
    "Enable secure role-based access and granular permissions for diverse healthcare professionals.",
    "Offer comprehensive APIs for integration with third-party services and external applications.",
    "Support scalability and optimized performance for large data volumes and concurrent users.",
    "Deliver multi-language and multi-currency support for global usability.",
    "Ensure regulatory compliance and security for sensitive healthcare data."
  ],
  "key_features": [
    "Complete Authentication and Role-based Authorization.",
    "Patient Management including registration, medical history, cases, and document handling.",
    "Doctor Management with profiles, departments, schedules, and OPD charge setup.",
    "Appointment Management with booking, scheduling, rescheduling, and cancellations.",
    "Bed Management with assignment, occupancy tracking, visualization, and IoT integration.",
    "Billing & Finance with invoices, payments, accounts, income, and expense tracking.",
    "Laboratory and Radiology management with test requests, results, and categories.",
    "Pharmacy Management covering medicine inventory, prescriptions, and pharmacist tasks.",
    "Blood Bank operations including inventory, donors, and requests.",
    "Ambulance and Emergency management with calls, dispatch, and billing integration.",
    "HR Management for employee profiles, payroll, attendance, and leave.",
    "Inventory Management for suppliers, stock movements and tracking.",
    "IPD and OPD workflows with admissions, visits, and records.",
    "Reports & Analytics producing birth, death, operation, and investigation reports.",
    "AI-powered advanced features including appointment suggestions and predictive analytics.",
    "System Settings and Configuration for localization, integrations, and API keys.",
    "Patient Portal for self-service appointment booking, medical records, and billing.",
    "CMS for managing content like blogs, galleries, careers, and testimonials."
  ],
  "user_flow_summary": [
    "Users authenticate with secure login and roles define their access levels.",
    "Admins manage hospital setup, departments, staff, and system settings.",
    "Doctors and nurses manage patient care, appointments, diagnoses, and ward assignments.",
    "Receptionists register patients, book appointments, and coordinate visit workflows.",
    "Pharmacists handle medicines inventory, prescriptions, and dispensing.",
    "Lab technicians and radiologists process test requests and results.",
    "Billing staff manage invoices, payments, and financial reporting.",
    "Patients use the portal to book appointments, view medical records, and manage billing.",
    "Integration services connect with payment gateways, calendar, telemedicine, and insurance APIs.",
    "System administrators monitor activity logs and configure system priorities and features."
  ],
